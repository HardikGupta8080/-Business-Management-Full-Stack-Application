<?xml version="1.0" encoding="utf-8"?>
<!-- Allows plain HTTP to the PC's LAN address (the Postgres-backed backend
     currently has no HTTPS certificate). Restricted to private/LAN use. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
